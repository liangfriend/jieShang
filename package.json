{
  "name": "jie-shang",
  "version": "1.0.0",
  "description": "An Electron application with Vue and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "node scripts/run-electron-vite.mjs preview",
    "dev": "node scripts/run-electron-vite.mjs dev",
    "dev:local": "node scripts/run-electron-vite.mjs dev --mode deciphony",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && node scripts/ensure-steam-dll.mjs && electron-builder --dir",
    "build:win": "npm run build && node scripts/ensure-steam-dll.mjs && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.jieshang.app",
    "productName": "解熵",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "extraResources": [
      {
        "from": "resources/collection-thumbnails",
        "to": "collection-thumbnails"
      },
      {
        "from": "src/main/resources/toneColors",
        "to": "toneColors",
        "filter": [
          "*.json"
        ]
      }
    ],
    "files": [
      "!steam_appid.txt",
      "!.dev-data/**",
      "!src/**",
      "!doc/**",
      "!scripts/**",
      "!*.tgz",
      "!*.md",
      "!*.tsbuildinfo",
      "!{.cursor,steam,steamAssets,tiktok}/**",
      "!tailwind.config.ts",
      "!**/.vscode/*",
      "!electron.vite.config.*",
      "!{.eslintcache,eslint.config.mjs,.prettierignore,.prettierrc.yaml,dev-app-update.yml,CHANGELOG.md,README.md,AGENTS.md}",
      "!{.env,.env.*,.npmrc,pnpm-lock.yaml}",
      "!{tsconfig.json,tsconfig.node.json,tsconfig.web.json}",
      "!node_modules/**/*.map",
      "!node_modules/@tailwindcss/oxide-wasm32-wasi/**",
      "!node_modules/@emnapi/**"
    ],
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "executableName": "jie-shang",
      "icon": "icon.png",
      "extraFiles": [
        {
          "from": "resources/steam/steam_api64.dll",
          "to": "steam_api64.dll"
        }
      ],
      "extraResources": [
        {
          "from": "resources/steam/vcruntime140.dll",
          "to": "app.asar.unpacked/node_modules/steamworks.js/dist/win64/vcruntime140.dll"
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png",
      "category": "public.app-category.music",
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "解熵需要使用麦克风进行音高识别、演唱评分与录音。"
      }
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "解熵"
    }
  },
  "dependencies": {
    "@deciphony/cl-sheet": "^0.0.2",
    "@deciphony/extensions": "^0.0.27",
    "@deciphony/finger": "^0.0.2",
    "@deciphony/number-notation-omr": "^0.1.8",
    "@deciphony/pitch-detection": "^0.0.2",
    "@deciphony/player": "^1.0.63",
    "@deciphony/puff": "^0.0.2",
    "@deciphony/renderer": "^0.0.64",
    "@deciphony/tune-judge": "^0.0.5",
    "@deciphony/work": "^0.0.20",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@tailwindcss/vite": "^4.1.17",
    "@vue/compiler-sfc": "^3.5.24",
    "awilix": "^12.0.5",
    "axios": "^1.13.2",
    "electron-updater": "^6.3.9",
    "element-plus": "^2.11.8",
    "fast-xml-parser": "^5.8.0",
    "gsap": "^3.13.0",
    "pinia": "^3.0.4",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.7",
    "steamworks.js": "^0.4.0",
    "tailwindcss": "^4.1.17",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.6.3",
    "xmlbuilder": "^15.1.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.18.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^39.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vue": "^3.5.21",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.7"
  }
}
